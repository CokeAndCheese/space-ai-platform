# MiniMax-M3 API 配置模板
# 复制本文件为 .env.local,然后填入你自己的 key
#   cp .env.local.example .env.local
#
# .env.local 已被 .gitignore 忽略,不会 commit
#
# ⚠️ 不要把真实 key commit 到 git (.env.local.example 是模板,理论上可以 commit,
#    但为了安全,也不要在模板里写真实 key —— 请占位符 'your-api-key-here')

# 完整 base URL, 必须以 /v1 结尾。不要使用 VITE_ 前缀，避免进入浏览器构建产物。
LLM_BASE_URL=https://api.minimax.chat/v1

# 模型名
VITE_LLM_MODEL=MiniMax-M3

# API key —— 仅供 Vite dev server / 生产代理读取，绝不使用 VITE_ 前缀。
LLM_API_KEY=your-api-key-here
