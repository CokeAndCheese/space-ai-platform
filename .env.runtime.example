# Server-only values. Never prefix secrets with VITE_ and never commit .env.runtime.
LLM_API_KEY=
LLM_BASE_URL=https://api.minimax.cn/v1
LLM_MODEL=MiniMax-M3
# Generate two independent 32-256 character base64url values; they must differ.
# LLM_EDGE_TOKEN is shared only with the Caddy runtime, never with the web container.
LLM_PROXY_TOKEN=
LLM_EDGE_TOKEN=
LLM_ALLOWED_ORIGIN=https://115.159.223.98
LLM_PORT=8787
LLM_MAX_BODY_BYTES=65536
LLM_REQUEST_READ_TIMEOUT_MS=10000
LLM_TIMEOUT_MS=20000
LLM_MAX_UPSTREAM_BODY_BYTES=4194304
LLM_MAX_STREAM_BYTES=1048576
LLM_MAX_COMPLETION_TOKENS=2048
LLM_RATE_LIMIT_PER_MINUTE=20
LLM_GLOBAL_RATE_LIMIT_PER_MINUTE=60
LLM_MAX_CONCURRENT=2
LLM_MAX_CONCURRENT_PER_CLIENT=1
LLM_DAILY_LIMIT=100
LLM_QUOTA_TIME_ZONE=Asia/Shanghai
LLM_QUOTA_LOCK_TIMEOUT_MS=2000
LLM_QUOTA_STATE_FILE=/var/lib/space-ai-platform/quota/daily.json
SPACE_AI_QUOTA_DIR=/srv/apps/space-ai-platform-data/llm-quota
