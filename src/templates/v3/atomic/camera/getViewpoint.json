{
  "schemaVersion": 3,
  "id": "getViewpoint",
  "version": "1.0.0",
  "kind": "atomic",
  "title": "获取当前视角",
  "description": "读取当前相机的位置、目标点和视场角。",
  "intents": ["获取当前视角", "读取相机状态", "保存视角"],
  "input": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "required": ["position", "target", "fov"],
    "properties": {
      "position": {
        "type": "object",
        "required": ["x", "y", "z"],
        "properties": {
          "x": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
          "y": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
          "z": { "type": "number", "minimum": -1000000, "maximum": 1000000 }
        },
        "additionalProperties": false
      },
      "target": {
        "type": "object",
        "required": ["x", "y", "z"],
        "properties": {
          "x": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
          "y": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
          "z": { "type": "number", "minimum": -1000000, "maximum": 1000000 }
        },
        "additionalProperties": false
      },
      "fov": { "type": "number", "minimum": 0, "maximum": 180 }
    },
    "additionalProperties": false
  },
  "effects": ["scene.read"],
  "risk": "read",
  "ai": { "exposed": false },
  "call": {
    "method": "cameraController.getViewpoint",
    "args": [],
    "result": { "kind": "direct" }
  }
}
