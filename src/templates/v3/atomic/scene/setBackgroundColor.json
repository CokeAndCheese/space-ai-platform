      }
    },
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "required": ["ok"],
    "properties": {
      "ok": { "const": true }
    },
    "additionalProperties": false
  },
  "effects": ["scene.write"],
  "risk": "visual",
  "ai": { "exposed": false },
  "call": {
    "method": "sceneTool.setBackgroundColor",
    "args": [{ "$input": "color" }],
    "result": { "kind": "receipt", "value": { "ok": true } }
  }
}
