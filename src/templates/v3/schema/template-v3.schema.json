{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://space-ai-platform.invalid/template-v3.schema.json",
  "title": "Space AI atomic template v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "kind",
    "title",
    "description",
    "intents",
    "input",
    "output",
    "effects",
    "risk",
    "ai",
    "call"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "kind": { "const": "atomic" },
    "title": { "type": "string", "minLength": 1, "maxLength": 128 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "intents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "input": { "$ref": "#/$defs/closedObjectSchema" },
    "internalOutput": { "$ref": "#/$defs/jsonSchema" },
    "output": { "$ref": "#/$defs/jsonSchema" },
    "effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "scene.read",
          "scene.write",
          "camera.write",
          "object.highlight",
          "object.visibility",
          "model.load",
          "model.unload",
          "topology.write",
          "dom.write",
          "download",
          "timer",
          "destructive"
        ]
      }
    },
    "risk": {
      "type": "string",
      "enum": ["read", "visual", "state", "destructive", "external"]
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exposed"],
      "properties": {
        "exposed": { "type": "boolean" },
        "requiresConfirmation": { "type": "boolean" }
      }
    },
    "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "deprecated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "replacedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "args", "result"],
      "properties": {
        "method": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*\\.[A-Za-z_$][A-Za-z0-9_$]*$"
        },
        "args": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["$input"],
                "properties": {
                  "$input": { "type": "string", "minLength": 1, "maxLength": 256 },
                  "default": { "$ref": "#/$defs/jsonValue" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["$literal"],
                "properties": {
                  "$literal": { "$ref": "#/$defs/jsonValue" }
                }
              }
            ]
          }
        },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "direct" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "value"],
              "properties": {
                "kind": { "const": "receipt" },
                "value": { "$ref": "#/$defs/jsonValue" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "receipt"],
              "properties": {
                "kind": { "const": "object-ref" },
                "receipt": { "$ref": "#/$defs/jsonValue" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "receipt"],
              "properties": {
                "kind": { "const": "object-ref-array" },
                "receipt": { "$ref": "#/$defs/jsonValue" }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "jsonValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "closedObjectSchema": {
      "allOf": [
        { "$ref": "#/$defs/jsonSchema" },
        {
          "type": "object",
          "required": ["type", "additionalProperties"],
          "properties": {
            "type": { "const": "object" },
            "additionalProperties": { "const": false }
          }
        }
      ]
    },
    "jsonSchema": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["object", "array", "string", "number", "integer", "boolean", "null"]
        },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonSchema" }
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": { "const": false },
        "items": { "$ref": "#/$defs/jsonSchema" },
        "enum": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        "const": { "$ref": "#/$defs/jsonValue" },
        "default": { "$ref": "#/$defs/jsonValue" },
        "anyOf": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/jsonSchema" }
        },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "exclusiveMinimum": { "type": "number" },
        "exclusiveMaximum": { "type": "number" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "minItems": { "type": "integer", "minimum": 0 },
        "maxItems": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "required": ["anyOf"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["type"] },
                { "required": ["properties"] },
                { "required": ["required"] },
                { "required": ["additionalProperties"] },
                { "required": ["items"] },
                { "required": ["enum"] },
                { "required": ["const"] },
                { "required": ["minimum"] },
                { "required": ["maximum"] },
                { "required": ["exclusiveMinimum"] },
                { "required": ["exclusiveMaximum"] },
                { "required": ["minLength"] },
                { "required": ["maxLength"] },
                { "required": ["minItems"] },
                { "required": ["maxItems"] },
                { "required": ["pattern"] }
              ]
            }
          }
        }
      ]
    }
  }
}
